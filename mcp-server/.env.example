# Settings for the DeckDen MCP server. This file is documentation only.
# The server reads the real environment and never loads this file itself.
#
# To run it locally, copy this file to .env (git-ignored), fill in the values,
# build, and start the server with Node's built-in --env-file:
#   node --env-file=.env dist/index.js
#
# Never put a real token in this file. Put it in .env, or in your assistant's config.

# Where the DeckDen API lives, for example http://localhost:8000 for a local backend.
# Must start with https://. Plain http:// is only accepted for localhost.
DECKDEN_API_URL=

# An access token from the "AI assistants" section of your DeckDen account page.
# It starts with dd_pat_ and is shown only once, when you connect an assistant.
DECKDEN_TOKEN=
